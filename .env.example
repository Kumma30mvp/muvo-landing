# ID de medición de GA4 (Administrar > Flujos de datos > Web). Sin él, la analítica queda desactivada.
VITE_GA4_ID=G-XXXXXXXXXX
# true = envía debug_mode a GA4 para verlo en DebugView (solo en Preview/desarrollo)
VITE_GA4_DEBUG=false
# URL pública (sin / final). Se usa en canonical, Open Graph, JSON-LD y sitemap.
VITE_SITE_URL=https://muvo-grupo01.vercel.app
